# Copy to /opt/argus/.env on the VM. This file must never be committed with values.
# ARGUS_IMAGE is deliberately supplied per-deploy by GitHub Actions.
ARGUS_BIND_ADDRESS=127.0.0.1
ARGUS_HOST_PORT=8000
ARGUS_ADMIN_TOKEN=replace-with-a-unique-long-random-token

# Optional integrations. Leave empty to disable the corresponding feature.
GITHUB_TOKEN=
GEMINI_API_KEY=
ARGUS_DISCOVERY_MODEL=gemini-3.6-flash
ARGUS_DISCOVERY_INTERVAL_SECONDS=604800
ARGUS_PLATEAU_WEEKS=12

# Only needed if the GHCR package remains private. Prefer making the package public.
# GHCR_USERNAME=
# GHCR_READ_TOKEN=
