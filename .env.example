# Required by Docker Compose. Use a strong secret outside local development.
ARGUS_ADMIN_TOKEN=replace-with-a-strong-admin-token

# Optional host port for the ARGUS web interface.
ARGUS_PORT=8000

# Optional but recommended for reliable scheduled GitHub collection. Use a
# fine-grained, read-only token; public showcase mode works without it.
GITHUB_TOKEN=

# Required only for the weekly emerging-technology discovery service. Create a
# Gemini API key in Google AI Studio and never commit the populated .env file.
GEMINI_API_KEY=

# Optional discovery and lifecycle tuning.
ARGUS_DISCOVERY_MODEL=gemini-3.6-flash
ARGUS_DISCOVERY_INTERVAL_SECONDS=604800
ARGUS_PLATEAU_WEEKS=12
