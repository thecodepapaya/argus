# Required by Docker Compose. Use a strong secret outside local development.
ARGUS_ADMIN_TOKEN=replace-with-a-strong-admin-token

# Optional host port for the ARGUS web interface.
ARGUS_PORT=8000

# Optional but recommended for reliable scheduled GitHub collection. Use a
# fine-grained, read-only token; public showcase mode works without it.
GITHUB_TOKEN=

# Optional OpenRouter key for weekly emerging-technology discovery and
# administrator-assisted technology-profile preparation. Never commit it.
OPENROUTER_API_KEY=

# Optional Cloudflare Web Analytics site token. When set, ARGUS loads the
# Cloudflare beacon on public pages only; the private /admin console is excluded.
ARGUS_CLOUDFLARE_ANALYTICS_TOKEN=

# Optional discovery and lifecycle tuning.
ARGUS_LLM_MODEL=openai/gpt-4.1-mini
ARGUS_DISCOVERY_MODEL=openai/gpt-4.1-mini
ARGUS_DISCOVERY_INTERVAL_SECONDS=604800
ARGUS_PLATEAU_WEEKS=12
